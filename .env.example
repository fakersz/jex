# JEX Environment Configuration
PORT=3001
GEMINI_MODEL=gemini-3.6-flash

# Caminho da biblioteca de música ambiente
MUSIC_LIBRARY_PATH=/media/music

# Configurações opcionais do Spotify Web API & OAuth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5173/auth/spotify/callback

# Substitua pela sua chave oficial da API Google Gemini
# Obtenha em: https://aistudio.google.com/
GEMINI_API_KEY=
